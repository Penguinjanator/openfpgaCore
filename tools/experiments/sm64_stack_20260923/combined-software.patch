+static inline void of_gpu_load_vert_clip_cd(uint8_t slot, int32_t cx, int32_t cy, int32_t cw,
+                                         int32_t s, int32_t t, uint16_t rgb,
+                                         uint32_t depth, uint16_t cd, int combine) {
