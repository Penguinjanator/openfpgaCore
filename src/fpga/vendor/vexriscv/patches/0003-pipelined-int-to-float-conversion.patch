+        packPort.cmd.roundMode := FpuUtils.ROUNDING
+        packPort.cmd.hartId := Global.HART_ID
+        packPort.cmd.uopId := Decode.UOP_ID
+
+        packPort.cmd.value.quiet := False
+        packPort.cmd.value.sign := RsUnsignedPlugin.RS1_REVERT
+        packPort.cmd.value.exponent := cvtWidth - apply(s1.SHIFT)
+        val data = apply(s2.SHIFTED)
+        if (widthOf(data) > widthOf(packPort.cmd.value.mantissa.raw)) {
+          packPort.cmd.value.mantissa.raw := data.takeHigh(p.mantissaWidth + 1) ## data.dropHigh(p.mantissaWidth + 1).orR
+        } else {
+          packPort.cmd.value.mantissa.raw := data << widthOf(packPort.cmd.value.mantissa.raw) - widthOf(data)
+        }
+        packPort.cmd.value.setNormal
+        when(apply(s0.ZERO)) {
