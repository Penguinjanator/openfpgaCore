+    {
+        R_ExactDistOffset(cache, &cache->view_distance, &cache->view_offset);
+        cache->view_validcount = bsp_view_validcount;
+    }
+    *dist_out = cache->view_distance;
+    *offset_out = cache->view_offset;
+}
