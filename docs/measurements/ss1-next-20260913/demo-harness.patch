+/* Private SS1 diagnostic: retain samples in SDRAM, write only after the run. */
+#include "g_game.h"
+#include "i_sound.h"
+extern volatile uint32_t ss1_midi_pump_us, ss1_midi_pump_calls, ss1_midi_pump_overruns;
+static int ss1_music_stopped;
+enum { CAPTURE_WORDS = 64, CAPTURE_FRAMES = 4092 };
+static uint32_t capture_data[CAPTURE_FRAMES][CAPTURE_WORDS];
+static uint32_t capture_count, capture_level_start, capture_previous;
+static uint32_t capture_duration = 30000000, capture_warmup = 5000000;
+static const char *capture_path;
+extern void R_GPU_ProfileCounters(uint32_t *out);
+
+static void capture_init(void)
+{
+    static int checked;
+    if (checked) return;
+    checked = 1;
+    int p = M_CheckParmWithArgs("-perfcapture", 1);
+    if (p) capture_path = myargv[p+1];
+    p = M_CheckParmWithArgs("-perfduration", 1);
+    if (p) { int n = atoi(myargv[p+1]); if (n >= 1 && n <= 60) capture_duration = n * 1000000u; }
+}
+
+static void capture_frame(uint32_t now)
+{
+    uint32_t gpu[20];
+    of_video_timing_t timing;
+    R_GPU_ProfileCounters(gpu);
+    if (!perf.frame_active || gamestate != GS_LEVEL || !gametic) return;
+    static int restarted;
+    if (!restarted && (M_CheckParm("-perfrestart") || M_CheckParm("-perfdemo"))) {
+        restarted = 1;
+        if (M_CheckParm("-perfdemo")) G_DeferedPlayDemo("demo1");
+        else G_DeferedInitNew(gameskill, gameepisode, gamemap);
+        return;
+    }
+    if (M_CheckParm("-perfdemo") && !demoplayback) return;
+    if (!capture_level_start) capture_level_start = now;
+    uint32_t age = now - capture_level_start;
+    if (M_CheckParm("-perfdemo")) age = (uint32_t)((uint64_t)leveltime * 1000000u / TICRATE);
+    uint32_t interval = capture_previous ? now - capture_previous : 0;
+    capture_previous = now;
+    if (!ss1_music_stopped && age >= 1000000 && M_CheckParm("-perfstopmusic")) {
+        I_StopSong();
+        ss1_music_stopped = 1;
+    }
+    if (age < capture_warmup) return;
+    of_video_get_timing(&timing);
+    uint32_t *r = capture_data[capture_count++];
+    r[0] = now; r[1] = interval; r[2] = now - perf.frame_start_us;
+    r[3] = gametic; r[4] = viewx; r[5] = viewy; r[6] = viewangle;
+    r[7] = timing.vblank_count; r[8] = timing.present_count;
+    r[9] = (uint32_t)timing.last_flip_presented_us;
+    for (unsigned i = 0; i < R_PERF_STAGE_COUNT; ++i) r[10+i] = perf.stage_us[i];
+    r[21] = perf.gpu_columns; r[22] = perf.gpu_column_pixels;
+    r[23] = perf.gpu_spans; r[24] = perf.gpu_span_pixels;
+    r[25] = perf.dma_waits; r[26] = perf.dma_spin_iters;
+    r[27] = perf.ring_waits; r[28] = perf.ring_spin_iters;
+    r[29] = perf.min_ring_free;
+    /* Match moving gameplay at simulation tics, independently of interpolation. */
+    r[25] = leveltime; r[26] = players[consoleplayer].mo->x;
+    r[27] = players[consoleplayer].mo->y; r[28] = players[consoleplayer].mo->angle;
+    r[29] = players[consoleplayer].mo->z;
+    for (unsigned i = 0; i < 20; ++i) r[30+i] = gpu[i];
+    r[50] = viewwidth; r[51] = viewheight; r[52] = gameepisode; r[53] = gamemap;
+    r[54] = of_get_caps()->cpu_freq_hz; r[55] = r_perf_summary_enabled;
+    r[56] = players[consoleplayer].health; r[57] = perf.direct_frames;
+    r[58] = ss1_prepare_us; r[59] = ss1_wait_us;
+    r[60] = ss1_music_stopped; r[61] = ss1_midi_pump_us; r[62] = ss1_midi_pump_calls; r[63] = ss1_midi_pump_overruns;
+    if (age >= capture_warmup + capture_duration || capture_count == CAPTURE_FRAMES)
+    {
+        int ok = 1;
+        for (uint32_t first = 0, part = 0; first < capture_count; ++part) {
+            uint32_t n = capture_count - first;
+            if (n > 1023) n = 1023;
+            uint32_t header[4] = {0x31504653, 4, CAPTURE_WORDS, n};
+            char path[16];
+            snprintf(path, sizeof(path), "save:%u", 6 + part);
+            FILE *f = fopen(path, "wb");
+            if (!f) { ok = 0; break; }
+            if (fwrite(header, sizeof(header), 1, f) != 1 ||
+                fwrite(capture_data[first], sizeof(capture_data[0]), n, f) != n) ok = 0;
+            if (fclose(f) != 0) ok = 0;
+            if (!ok) break;
+            first += n;
+        }
+        if (ok) {
+            uint32_t done[4] = {0x454e4f44, capture_count, CAPTURE_WORDS, 1};
+            FILE *f = fopen("save:5", "wb");
+            if (!f) ok = 0;
+            else { if (fwrite(done, sizeof(done), 1, f) != 1) ok = 0; if (fclose(f)) ok = 0; }
+        }
+        printf("SS1 capture %s: %u frames at %s\n", ok ? "complete" : "FAILED", capture_count, capture_path);
+        exit(ok ? 0 : 1);
+    }
+}
