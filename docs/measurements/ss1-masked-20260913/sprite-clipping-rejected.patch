+#!/usr/bin/env python3
+"""Compare the production sprite clip walk and masked-wall draw ordering."""
+import argparse, hashlib, os, subprocess
+from pathlib import Path
+from gpu_test_sources import function
+ROOT=Path(__file__).resolve().parents[1]
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--reference',type=Path,required=True)
+    p.add_argument('--output',type=Path,required=True)
+    a=p.parse_args(); hashes=[]
+    for name,source in [('before',a.reference),('after',ROOT/'src/doom/cdoom/doom/r_things.c')]:
+        out=a.output.resolve()/name;out.mkdir(parents=True,exist_ok=True)
+        s=source.read_text();names=['R_DrawSprite']
+        if 'static void R_ApplySpriteClip(' in s:names.insert(0,'R_ApplySpriteClip')
+        (out/'clip_functions.h').write_text('\n'.join(function(s,n) for n in names))
+        cmd=['cc','-DOF_PC','-DOF_DOOM','-O2','-g','-fsanitize=address,undefined','-fno-omit-frame-pointer','-no-pie','-I'+str(out)]
+        cmd+=['-I'+str(ROOT/d) for d in ['src/sdk/include','src/doom/shim','src/doom/cdoom','src/doom/cdoom/doom']]
+        cmd+=[str(ROOT/'tools/tests/test_sprite_clipping.c'),'-o',str(out/'test')]
+        with (out/'build.log').open('w') as f:subprocess.run(cmd,stdout=f,stderr=subprocess.STDOUT,check=True)
+        with (out/'records.bin').open('wb') as f,(out/'run.log').open('w') as log:
+            subprocess.run([str(out/'test')],stdout=f,stderr=log,check=True,env=dict(os.environ,UBSAN_OPTIONS='halt_on_error=1'))
+        hashes.append(hashlib.sha256((out/'records.bin').read_bytes()).hexdigest())
+        print(name,(out/'run.log').read_text().strip(),flush=True)
+    assert hashes[0]==hashes[1],'Sprite clipping or draw order changed'
+    print('PASS identical sprite clipping and masked range order',hashes[0])
+if __name__=='__main__':main()
