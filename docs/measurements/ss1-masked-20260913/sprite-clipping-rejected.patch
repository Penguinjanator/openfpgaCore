+static void R_ApplySpriteClip(short *clip, const short *source,
+                              uint32_t *pending, int first, int last)
+{
+    int firstword = first >> 5;
+    int lastword = last >> 5;
+    for (int word = firstword; word <= lastword; word++)
+    {
+        uint32_t mask = pending[word];
+        if (word == firstword)
+            mask &= UINT32_MAX << (first & 31);
+        if (word == lastword)
+            mask &= UINT32_MAX >> (31 - (last & 31));
+        while (mask)
+        {
+            unsigned int bit = __builtin_ctz(mask);
+            int x = (word << 5) + bit;
+            clip[x] = source[x];
+            /* Retain the scalar sentinel semantics even for an unresolved
+             * source entry. Each resolved column is visited only once. */
+            if (clip[x] != -2)
+                pending[word] &= ~(UINT32_C(1) << bit);
+            mask &= mask - 1;
+        }
+    }
+}
