+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include "r_local.h"
+typedef struct { short x1,x2;drawseg_t *ds; } drawsegrange_t;
+static drawsegrange_t drawsegranges[96];
+static int numdrawsegranges;
+static drawseg_t segments[96];
+static seg_t clip_lines[96];
+static short tops[96][320],bots[96][320],masked[320];
+short *mfloorclip,*mceilingclip;
+int viewheight=168;
+static unsigned seed=0x719afad3, masked_calls, side_calls;
+static unsigned rnd(void){seed^=seed<<13;seed^=seed>>17;seed^=seed<<5;return seed;}
+static void emit(const void *p,size_t n){assert(fwrite(p,1,n,stdout)==n);}
+void R_RenderMaskedSegRange(drawseg_t *ds,int first,int last){
+    int32_t row[]={ds-segments,first,last};emit(row,sizeof(row));masked_calls++;
+}
+int R_PointOnSegSide(fixed_t x,fixed_t y,seg_t *line){
+    side_calls++;return ((uint32_t)x^(uint32_t)y^(unsigned)(line-clip_lines))&1;
+}
+void R_DrawVisSprite(vissprite_t *spr,int first,int last){
+    int32_t row[]={-1,first,last,spr->scale};emit(row,sizeof(row));
+    emit(mfloorclip+first,(last-first+1)*sizeof(short));
+    emit(mceilingclip+first,(last-first+1)*sizeof(short));
+}
+#include "clip_functions.h"
+int main(void){
+    for(int trial=0;trial<24000;trial++){
+        vissprite_t spr={0};
+        viewheight=trial%3?168:96;
+        spr.x1=trial%5?rnd()%320:0;
+        spr.x2=trial%7?spr.x1+rnd()%(320-spr.x1):319;
+        spr.scale=rnd()%0x80000000u;spr.gz=(int32_t)rnd();spr.gzt=(int32_t)rnd();
+        spr.gx=(int32_t)rnd();spr.gy=(int32_t)rnd();
+        numdrawsegranges=rnd()%97;
+        for(int n=0;n<numdrawsegranges;n++){
+            drawseg_t *ds=&segments[n];
+            int x1=trial%5?rnd()%320:0;
+            int x2=trial%5?x1+rnd()%(320-x1):319;
+            drawsegranges[n]=(drawsegrange_t){x1,x2,ds};
+            ds->scale1=rnd()%0x80000000u;ds->scale2=rnd()%0x80000000u;
+            ds->silhouette=rnd()%4;ds->bsilheight=(int32_t)rnd();ds->tsilheight=(int32_t)rnd();
+            ds->curline=&clip_lines[n];ds->maskedtexturecol=rnd()%3?NULL:masked;
+            ds->sprbottomclip=bots[n];ds->sprtopclip=tops[n];
+            for(int x=0;x<320;x++){
+                bots[n][x]=(int)(rnd()%(viewheight+3))-2;
+                tops[n][x]=(int)(rnd()%(viewheight+3))-2;
+            }
+        }
+        R_DrawSprite(&spr);
+    }
+    assert(masked_calls>10000&&side_calls>10000);
+    fprintf(stderr,"PASS 24000 sprite walks; %u masked range draws; %u side tests\n",masked_calls,side_calls);
+}
